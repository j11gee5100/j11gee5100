[Unit]
Description=OpsPaw Orchestrator Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jykj
Group=jykj
WorkingDirectory=/home/jykj/opspaw
EnvironmentFile=/home/jykj/opspaw/.env
ExecStart=/home/jykj/opspaw/.venv/bin/python -m app.workers.orchestrator
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
