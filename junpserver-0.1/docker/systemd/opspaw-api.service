[Unit]
Description=OpsPaw API (bare-metal)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jykj
Group=jykj
WorkingDirectory=/home/jykj/opspaw
EnvironmentFile=/home/jykj/opspaw/.env
ExecStart=/home/jykj/opspaw/.venv/bin/uvicorn app.api.main:app --host 0.0.0.0 --port 18080
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
